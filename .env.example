# PostgreSQL connection (matches docker-compose.yml for local development)
DATABASE_URL="postgresql://tsevedi:tsevedi@localhost:5432/tsevedi?schema=public"

# Password for the /admin moderation dashboard. Use a long random value in production.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (at least 32 random characters).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-of-32-chars-or-more"

# Public URL of the site, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to 1 to turn off spam rate limits (used by the end-to-end tests). Never set in production.
# DISABLE_RATE_LIMIT=1

# Sign-in providers. Leave empty to hide a provider. See README "Sign-in setup".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional: Better Auth falls back to SESSION_SECRET and NEXT_PUBLIC_SITE_URL.
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL=""

# Enables email+password sign-in for automated tests only. Never set in production.
# ENABLE_TEST_AUTH=1
