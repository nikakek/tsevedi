// Tsevedi data model.
//
// A Listing is one regular trip a driver runs, e.g. "Tbilisi → Ambrolauri → Oni, daily at 09:00".
// Its ordered RouteStops let a search for any two places along the way find it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlaceKind {
  CITY
  TOWN
  VILLAGE
  RESORT
  AIRPORT
  BORDER
}

enum VehicleType {
  MARSHRUTKA
  MINIVAN
  SEDAN
  SUV
  BUS
}

enum Language {
  KA
  RU
  EN
  TR
  HY
  AZ
}

/// UNCLAIMED: added by someone else, no account. PENDING/APPROVED/REJECTED: registered by the driver.
enum DriverStatus {
  UNCLAIMED
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum RideOutcome {
  WORKED
  DIFFERENT
  DID_NOT_RUN
}

enum ProblemKind {
  WRONG_TIME
  WRONG_PRICE
  NOT_RUNNING
  WRONG_PHONE
  OTHER
}

model Place {
  id      String    @id @default(cuid())
  slug    String    @unique
  nameKa  String
  nameEn  String
  nameRu  String
  /// Extra spellings people search for: "Kazbegi", "Qvareli", "TBS", ...
  aliases String[]
  region  String
  kind    PlaceKind
  lat     Float
  lng     Float

  stops RouteStop[]
}

model Driver {
  id           String      @id @default(cuid())
  name         String
  /// E.164 format, e.g. +995555123456
  phone        String
  whatsapp     Boolean     @default(false)
  viber        Boolean     @default(false)
  telegram     Boolean     @default(false)
  languages    Language[]
  vehicleType  VehicleType
  vehicleModel String?
  vehicleColor String?
  plate        String?
  seats        Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  /// Set when the driver registered with their own account.
  userId     String?      @unique
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     DriverStatus @default(UNCLAIMED)
  approvedAt DateTime?

  listings Listing[]
  savedBy  SavedDriver[]

  @@index([phone])
  @@index([status])
}

model Listing {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  stops RouteStop[]

  /// Local Georgian time, "HH:MM".
  departureTime    String
  /// ISO weekdays the trip runs: 1 = Monday ... 7 = Sunday.
  days             Int[]
  /// Months the trip runs (1-12). Empty means all year.
  activeMonths     Int[]
  departurePoint   String
  departureMapsUrl String?
  /// Departure time of the trip back from the last stop, if the driver returns the same way.
  returnTime       String?
  returnPoint      String?

  /// Prices in GEL.
  pricePerSeat      Int?
  priceWholeVehicle Int?
  largeLuggage      Boolean?
  callAhead         Boolean  @default(true)
  notes             String?

  status            ListingStatus @default(PENDING)
  submittedByDriver Boolean       @default(false)
  submittedById     String?
  submittedBy       User?         @relation("SubmittedListings", fields: [submittedById], references: [id], onDelete: SetNull)
  submitterContact  String?
  adminNote         String?
  lastConfirmedAt   DateTime?
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  rideReports    RideReport[]
  problemReports ProblemReport[]
  savedBy        SavedListing[]

  @@index([status])
  @@index([driverId])
  @@index([submittedById])
}

model RouteStop {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place   @relation(fields: [placeId], references: [id])
  position  Int

  @@unique([listingId, position])
  @@index([placeId])
}

/// "I took this ride" reports from travellers keep listings fresh without the admin calling every driver.
model RideReport {
  id         String      @id @default(cuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  travelDate DateTime    @db.Date
  outcome    RideOutcome
  departedAt String?
  pricePaid  Int?
  comment    String?
  hidden     Boolean     @default(false)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([listingId, hidden])
}

model ProblemReport {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind      ProblemKind
  message   String?
  resolved  Boolean     @default(false)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([resolved])
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth). Field names follow Better Auth's core schema.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Banned users can't sign in or contribute.
  banned    Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?

  sessions          Session[]
  accounts          Account[]
  driver            Driver?
  savedDrivers      SavedDriver[]
  savedListings     SavedListing[]
  submittedListings Listing[]       @relation("SubmittedListings")
  rideReports       RideReport[]
  problemReports    ProblemReport[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SavedDriver {
  userId    String
  driverId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([userId, driverId])
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}
